# Copy this file to ".env" and fill in your real values.
# NEVER commit the actual ".env" file to GitHub — only this .example file.

BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=your_bot_username_without_at

CHANNEL_IDS=@channel1,@channel2,@channel3
CHANNEL_INVITE_LINKS=https://t.me/channel1,https://t.me/channel2,https://t.me/channel3

# The public URL where mini_app.html is hosted (e.g. your Vercel URL)
WEBAPP_URL=https://your-vercel-app.vercel.app

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_secret_service_role_key

SPINS_PER_REFERRAL=1
SIGNUP_FREE_SPINS=1
